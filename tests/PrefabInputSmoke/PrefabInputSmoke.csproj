<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ResonitePath Condition="'$(ResonitePath)' == '' and '$(RESONITE_PATH)' != ''">$(RESONITE_PATH)</ResonitePath>
    <ResonitePath Condition="'$(ResonitePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Resonite</ResonitePath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/VrmToResonitePackage/VrmToResonitePackage.csproj" />
    <Reference Include="AssimpNet"><HintPath>$(ResonitePath)/AssimpNet.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
