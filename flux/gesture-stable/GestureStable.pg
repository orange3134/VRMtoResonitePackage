// Per-user last-sent state for an existing hand graph.
// Candidate sources and Check.OnTrue are linked to that graph after SDK deployment.
// CallInput nodes keep the three operations reachable without automatic execution.
module GestureStable
in Candidate: int
where {
    store Stable: int;
    store HasStable: bool;
    Check = If(Condition=OR_Bool(NOT_Bool(HasStable), ValueNotEquals<int>(Candidate, Stable)));
    Remember = impulse {
        Stable <- Candidate;
        HasStable <- true;
    };
    Reset = impulse {
        Stable <- -1;
        HasStable <- false;
    };
    CallInput(Check);
    CallInput(Remember);
    CallInput(Reset);
}
